0:["PTF5f6zbP51hXl6zOpnuH",[[["",{"children":[["slug","tv-smiles-voice","d"],{"children":["__PAGE__?{\"slug\":\"tv-smiles-voice\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","tv-smiles-voice","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/tv-smiles-voice#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"TV Smiles Voice\",\"item\":\"https://www.voiceoverguy.co.uk/tv-smiles-voice\"}]}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"TV Smiles Voice"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>Another ad with this TV Smiles Voice. Running as part of a SKY Ad smart campaign.</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main one-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>TV Smiles Voice</h2>\r\n<p>My TV Smiles voice was as quirky and wacky as possible. That's what the video producers asked for and I think I more than delivered! I drew on a lot of my experience providing voiceover for children's TV and toy advertisements, such as my <a href=\"/bugs-in-kitchen-voice\" target=\"_blank\" title=\"Bugs in the Kitchen\">Bugs in the Kitchen</a>, <a href=\"/greedy-granny-tv-commercial\" title=\"Greedy Granny\">Greedy Granny</a>, and <a href=\"/pirate-voiceover\" title=\"Pirate Bridge\">Pirate Bridge</a>. My voice and natural bright tone seems to be a great fit for children's toys and shows and it was a brilliant fit for this TV Smiles promo.</p>\r\n"}}],false,false]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/tv-smiles-voice.jpg","alt":"TV Smiles Voice","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<br>\r\n<h2>So, What is TV Smiles</a>?</h2>\r\n\r\n<p><em><a href=\"https://twitter.com/tvsmiles\" target=\"_blank\" title=\"TV Smiles\" rel=\"noopener noreferrer\">TV SMILES</a> – Makes ad-breaks rewarding! Do you love doing quizzes but find it unfair that it’s always someone else who wins at Who Wants to be a Millionaire? TVSMILES turns this idea on its head and makes you a guaranteed winner every time you play.</em> This idea is a lot of fun and I think it's going to be a huge success. There's the added bonus of keeping yourself entertained during the ad breaks, which definitely appeals to me! I've voiced quite a few apps and games recently and this is probably only going to increase in the near future!</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Get in touch</h2>\r\n<p>If you are looking for a voice similar to the TV Smiles Voice, perhaps something from my <a href=\"/commercial-voiceover\" target=\"_blank\" title=\"Commercial Voiceover\">commercial voiceover showreel</a>, please get in touch. Ping me some of the script. I'll gladly send you a short voice sample first to see if my voice is right for what you are creating. Tell me more about your project and let's see if we can work together.</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"TV Smiles Voice","pageUrl":"tv-smiles-voice"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","855",{"href":"/welsh-accent-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/welsh-accent-voiceover.jpg","alt":"welsh-accent-voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Looking for a Welsh Accent?"}]]}],["$","$L3","985",{"href":"/beccas-bunce-voice-of-ringo","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/beccas-bunce-voice-of-ringo.jpg","alt":"Becca’s Bunch Voiceover – Ringo the Turtle Character","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Becca’s Bunch Voiceover – Ringo the Turtle"}]]}],["$","$L3","674",{"href":"/eze-group-explainer-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/eze-group-explainer-voice.jpg","alt":"Eze Group Explainer Voice","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Eze Group Explainer Voice"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/ac5a13a32dde8802.css","precedence"