0:["Y3lXzMUYotEdWCFodbAa7",[[["",{"children":["football-commentator-voice",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["football-commentator-voice",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"inner-page","children":[["$","section",null,{"className":"inner-hero","children":["$","div",null,{"className":"inner-container","dangerouslySetInnerHTML":{"__html":"<h1>The UK’s Leading <span class=\"ident\">Football Commentator</span> Voice</h1>\r\n<p>Looking for a high-energy, big-match commentator voice? Whether it’s a spoof sports promo, a comedy sketch, a stadium-style TV trailer or a high-pressure brand campaign, I deliver that unmistakable football excitement on cue.</p>\r\n\r\n<p>My commentary work has featured across major broadcasters and global brands — from <strong>BBC Radio 1</strong> to <strong>Netflix</strong>, <a href=\"qatar-drone-race-psg-voiceover\">Paris Saint-Germain’s Qatar Drone Race</a>, <a href=\"just-eat-uefa-football-commentator-voice\">Just Eat UEFA promos</a>, and national ad campaigns. If you want the drama, the urgency, and the iconic British tone — you’re in the right place.</p>"}}]}],["$","div",null,{"className":"inner-bar"}],["$","div",null,{"className":"inner-parallax","children":["$","div",null,{"className":"inner-container","children":[["$","div","0",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<h2><span class=\"ident\">Seamless Technology Meets Authentic Commentary</span></h2>\r\n<p>With experience voicing for <a href=\"iboy-football-commentator\" class=\"isred\" title=\"Netflix voiceover\">Netflix</a>'s iBoy, major brands like <a href=\"pizza-hut-delivery-football-commentator-voiceover\" class=\"isred\" target='_blank\" title=\"Pizza Hut football commentary\">Pizza Hut</a> and <a href=\"manchester-city-football-commentry-voice\" class=\"isred\" target=\"_blank\" title=\"Man City\">Man City</a>, my voice adds the final touch of drama to your campaign. I can take direction via Source Connect, Cleanfeed or Zoom to get the perfect take remotely, fast.</p>\r\n<p>If you like this style, you might also enjoy my <a href=\"movie-trailer-voice\" title=\"Movie Trailer Voice\">Movie Trailer</a>, <a href=\"gameshow-host\" title=\"Gameshow Host Voice\">Gameshow Host</a> or even my <a href=\"voice-of-god\" title=\"Voice of God\">Voice of God</a> reads - all delivered from my broadcast-quality studio.</p>"}}],"$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/T9opwMc46Ms","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","1",{"className":"inner-row reverse","children":[["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/1wYjSxN9mJI","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<h2><span class=\"ident\">Two Decades of Voiceover Excellence</span></h2>\r\n<p>For over 20 years, I’ve delivered football-style voiceovers worldwide. I’ve voiced major campaigns including <a href=\"etisalat-celebrating-victory-football-commentator-voice\">Etisalat’s “Celebrating Victory”</a> and <a href=\"betfred-football-commentator\">Betfred</a>, bringing big-match energy to scripted and improvised reads.</p>\r\n\r\n<p>I provide broadcast audio, fast delivery and reliable direction-friendly sessions. Intensity, comic timing or full commentator chaos? I’ve the versatility and experience to hit the brief.</p>\r\n\r\n<p>From one-liners to full campaign coverage, you get consistency, clarity and that instantly recognisable football commentator sound.</p>"}}],"$undefined","$undefined","$undefined"]}]]}],["$","div","2",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<h2>Trusted by Premier Brands</h2>\r\n<p>My voice has featured in global ads, radio promos, sketches, digital campaigns and even stadium content. Whatever the brief — drama, parody or full-tilt excitement — I bring the energy and authenticity clients rely on.</p>\r\n\r\n<p>You’ll also find me voicing <a href=\"santa-voice\">Santa</a>, <a href=\"david-attenborough-voice\">David Attenborough-style narration</a>, and <a href=\"pathe-news-voice\">Pathé News</a> reads, giving brands a full spectrum of character and documentary styles.</p>\r\n\r\n<p><a href=\"contact-guy\" class=\"isred\">Get in touch</a> to book a session or request a quote for your next project.</p>"}}],"$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined","$undefined","$undefined",["$","img",null,{"src":"/assets/images/football-commentator-voice-og.jpg","alt":"Football Commentator Voice – Guy Harris","style":{"width":"100%","borderRadius":4,"marginTop":8}}]]}]]}]]}]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","football-commentator-voice","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/f31072523b89a06f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en-GB","children":["$",