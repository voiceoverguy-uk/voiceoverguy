0:["uZlw_rSN16EBLe2H5Gx5t",[[["",{"children":[["slug","apple-voiceover","d"],{"children":["__PAGE__?{\"slug\":\"apple-voiceover\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","apple-voiceover","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/apple-voiceover#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"That Apple Style VoiceOver?\",\"item\":\"https://www.voiceoverguy.co.uk/apple-voiceover\"}]}"}}],["$","script","schema-2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/apple-voiceover#video\",\"name\":\"That Apple Style VoiceOver?\",\"thumbnailUrl\":\"https://img.youtube.com/vi/V6HuBB4WqxQ/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/V6HuBB4WqxQ\",\"author\":{\"@type\":\"Person\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk/voiceoverguy\",\"image\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-profile.jpg\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"VoiceoverGuy\",\"url\":\"https://www.voiceoverguy.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.png\"}},\"inLanguage\":\"en-GB\",\"description\":\"Sleek and minimal Apple-style voiceovers voiced by Guy Harris. Used in iPhone ads and explainer content — calm, clear, and polished to perfection.\",\"uploadDate\":\"2013-11-01T00:00:00+00:00\"}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"That Apple Style VoiceOver?"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>A couple of years ago I was asked if I'd like to be the voice of Apple on the iPhone television commercials. When you look at Apple's marketing and see it's celebrity endorsed, would I like to do them? Absolutely.</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main two-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>Check out the video</h2>\r\n<p>The session was awesome and the client approved the audio immediately. To this day I have a framed copy of the script in my studio. \r\nMy <a href=\"/apple-voice-style\" target=\"_blank\" title=\"natural style\">natural style</a> has been in demand ever since. From corporate voice work to <a href=\"/explainer-video-voice\" target=\"_blank\" title=\"Explainer Video Voiceover\">explainer videos</a> and <a href=\"/on-hold-voice\" target=\"_blank\" title=\"on Hold Voiceover\">on hold messages</a>. When setting out on this journey, I didn't think my regular speaking voice would overtake everything else I'm booked for, but there's been a huge influx of companies asking for the natural voice. You might also like to check out my <a href=\"/because-i-see-voiceover\" target=\"_blank\" title=\"Because I See Voiceover\">Because I See</a> and <a href=\"/save-water\" target=\"_blank\" title=\"Save Water Voiceover\">Save Water</a> videos.</p>"}}],false,["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/V6HuBB4WqxQ","title":"That Apple Style VoiceOver?","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}]}]]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/apple-voice-style.jpg","alt":"Apple Voiceover","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<br>\r\n<h2>The Apple Voice over style</h2>\r\n<p>\r\nThese adverts completely changed the direction my career as a voice over was going. Several times a week I'm asked for the Apple voice style. Including Stormfront, the Apple reseller.<br>I think clients are referring to the natural and conversational tone, often understated and soft but with short meaningful script writing, can have a huge impact. This style is often used for <a href=\"/explainer-video-voice\" target=\"_blank\" title=\"Explainer Video Voiceover\">explainer videos</a>, so take a look at my <a href=\"/hotels-dot-com-what-else-could-go-wrong-voiceover\" target=\"_blank\" title=\"Hotels.com\">Hotels.com</a> videos for a better idea of how effective my natural voiceover can be.</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Get in touch</h2>\r\n<p>Are you looking for this voice style for your next <a href=\"/commercial-voiceover\" target=\"_blank\" title=\"Commercial Voiceover\">promo video</a>? One similar to this Apple voice over style? Please get in touch if you'd like to work with me. I'd be very happy to send a short sample of your script to you before you book me. Please send a few lines of the script first so you can be sure I'm right for your brand. I make the whole process as easy as possible with 99% of the jobs delivered the same day.</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"That Apple Style VoiceOver?","pageUrl":"apple-voiceover"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","681",{"href":"/worms-wmd-character-voices","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/worms-wmd-character-voices.jpg","alt":"Worms WMD Character Voices","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Worms WMD Character Voices"}]]}],["$","$L3","894",{"href":"/poundland-yoda-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/poundland-yoda-voice.jpg","alt":"poundland-yoda-voice","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Yoda Voiceover for Poundland"}]]}],["$","$L3","512",{"href":"/land-of-eyas-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/land-of-eyas-voiceover.jpg","alt":"Land of Eyas Voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Land of Eyas Voiceover"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/7c08e83cf1ba7081.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en-GB","childre