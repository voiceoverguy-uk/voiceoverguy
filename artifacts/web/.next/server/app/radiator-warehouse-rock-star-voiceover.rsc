0:["wrtXmcXlkJyGqbgwCa5zJ",[[["",{"children":[["slug","radiator-warehouse-rock-star-voiceover","d"],{"children":["__PAGE__?{\"slug\":\"radiator-warehouse-rock-star-voiceover\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","radiator-warehouse-rock-star-voiceover","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/radiator-warehouse-rock-star-voiceover#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Radiator Warehouse – Radiators That Rock Voiceover\",\"item\":\"https://www.voiceoverguy.co.uk/radiator-warehouse-rock-star-voiceover\"}]}"}}],["$","script","schema-2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/radiator-warehouse-rock-star-voiceover#video\",\"name\":\"Radiator Warehouse – Radiators That Rock Voiceover\",\"thumbnailUrl\":\"https://img.youtube.com/vi/GmcfnTEeB_Y/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/GmcfnTEeB_Y\",\"author\":{\"@type\":\"Person\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk/voiceoverguy\",\"image\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-profile.jpg\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"VoiceoverGuy\",\"url\":\"https://www.voiceoverguy.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.png\"}},\"inLanguage\":\"en-GB\",\"description\":\"Guy Harris voices the bold “Radiators That Rock” campaign for Radiator Warehouse — rock‑star energy meets radiator heat. Feel the power in every line!\",\"uploadDate\":\"2026-01-13T00:00:00+00:00\"}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"Radiator Warehouse – Radiators That Rock Voiceover"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>Rock‑star energy meets radiator heat, Guy Harris delivers the voiceover for Radiator Warehouse’s “Radiators That Rock” campaign.</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main two-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2><strong>Heating Up the Airwaves with Style</strong></h2>\r\n<p>I was thrilled to be chosen as the voice behind the new bold radio and TV spot for <strong>Radiator Warehouse</strong>, creators of affordable designer radiators from just £43. Their tagline, “Radiators That Rock, Feel the Heat, Feel the Power!”, needed a voice to match the swagger, and we went full rock‑star with it: strong, charismatic, and unmistakably powerful.</p>\r\n<p>For those who don’t know, <em>The Radiator Warehouse</em> specialises in a wide range of high‑quality radiators, towel rails and heating solutions with free UK delivery and excellent reviews from satisfied customers.</p>"}}],false,["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/GmcfnTEeB_Y","title":"Radiator Warehouse – Radiators That Rock Voiceover","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}]}]]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/radiator-warehouse-voice.jpg","alt":"radiator warehouse voiceover","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2><strong>Rock Concert Vibes for Radiators</strong></h2>\r\n<p>The brief was fun: make radiators feel like a rock anthem. From that opening line voiced with punch to the energetic delivery throughout, this ad blends personality with purpose, helping Radiator Warehouse stand out from the usual DIY heating ads. Whether it’s flat panel radiators or vertical designs, they’ve got a style for every home. And in case you’re wondering… yes, it *does* feel like standing front row with the amps cranked and your heater pulling centre stage. The heat is real, and so is the power!</p>"}}]]}],[["$","div","0",{"className":"blog-post-section ","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2><strong>Need a Voice That Rocks… or Just Warms</strong></h2>\r\n<p>Whether it’s a quirky commercial like this one, a corporate explainer, or even a bold character narration, I’ve got the delivery to match. From natural‑sounding reads to voices with edge and personality, my studio setup means fast turnaround and professional quality every time.</p>\r\n<p>Have a listen to some other styles on my <a href=\"/voiceover-news\" title=\"Voice Demos\">voice demos</a> page, or drop me a script via the <a href=\"/contact-guy\" title=\"Contact Guy\">contact page</a> and let’s make your project sing.</p>"}}],null]}]],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2><strong>Let’s Get Your Script Heard</strong></h2>\r\n<p>If you’ve got a campaign that needs attitude, warmth, gravitas or energy, I’m here to help. Whether you’re working on a commercial, trailer, explainer or broadcast ad, send across your script and I’ll happily provide a quote or demo read. <a href=\"/mailto:guy@voiceoverguy.co.uk?subject=VoiceoverGuy Enquiry\" title=\"Email Guy direct now\">📧 Get in touch</a> today!</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"Radiator Warehouse – Radiators That Rock Voiceover","pageUrl":"radiator-warehouse-rock-star-voiceover"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","936",{"href":"/vegan-film-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/vegan-film-voiceover.jpg","alt":"vegan-film-voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Voice for Plant Based News Vegan Film "}]]}],["$","$L3","596",{"href":"/dead-daises-album-promo","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/dead-daises-album-promo.jpg","alt":"Dead Daises Album Promo","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Dead Daises Album Promo"}]]}],["$","$L3","810",{"href":"/guide-to-a-northern-irish-accent","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/guide-to-a-northern-irish-accent.jpg","alt":"British voice over: Guide to a Northern Irish Accent","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Guide to a Northern Irish Accent"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["ch