 – specialist voiceover site","children":"Voice of God"}],["$","span",null,{"className":"footer-sister-sep","aria-hidden":"true","children":"·"}],["$","a",null,{"href":"https://www.santaguy.co.uk/","target":"_blank","rel":"noopener noreferrer","aria-label":"Santa Guy – Santa voiceover specialist","children":"Santa Guy"}],["$","span",null,{"className":"footer-sister-sep","aria-hidden":"true","children":"·"}],["$","a",null,{"href":"https://www.pathevoice.co.uk/","target":"_blank","rel":"noopener noreferrer","aria-label":"Pathé Voice – Pathé-style voiceover","children":"Pathé Voice"}],["$","span",null,{"className":"footer-sister-sep","aria-hidden":"true","children":"·"}],["$","a",null,{"href":"https://halloweenvoice.co.uk/","target":"_blank","rel":"noopener noreferrer","aria-label":"Halloween Voice – spooky voiceover specialist","children":"Halloween Voice"}],["$","span",null,{"className":"footer-sister-sep","aria-hidden":"true","children":"·"}],["$","a",null,{"href":"https://www.arabellaharris.com/","target":"_blank","rel":"noopener noreferrer","aria-label":"Arabella Harris Voiceover","children":"Arabella Harris Voiceover"}]]}]]}]]}]}]]}]]}]],null],null],["$L9",null]]]]
