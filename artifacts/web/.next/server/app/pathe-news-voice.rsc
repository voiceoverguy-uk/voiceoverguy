0:["Y3lXzMUYotEdWCFodbAa7",[[["",{"children":["pathe-news-voice",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["pathe-news-voice",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"inner-page","children":[["$","section",null,{"className":"inner-hero","children":["$","div",null,{"className":"inner-container","dangerouslySetInnerHTML":{"__html":"<h1>Capture the Vintage Vibes with a Genuine <span class=\"ident\">Pathe News</span> voice</h1>\r\n<p>Embark on a nostalgic journey with the voice style that dominated British newsreels from the 1940s to the 1960s. <br>Perfect for lending a classic, retro touch to your project, my Pathe News voice captures the essence of this iconic era. \"Attention, all listeners! Don't dilly-dally—book your project today!\"</p>"}}]}],["$","div",null,{"className":"inner-bar"}],["$","div",null,{"className":"inner-parallax","children":["$","div",null,{"className":"inner-container","children":[["$","div","0",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2>Relive the Golden Age with <span class=\"ident\">Horlicks</span> : A Case Study</h2>\r\n<p>When Horlicks, the esteemed nutritional malt milk drink brand, aimed to narrate its rich history, only a genuine Pathe News voice could do justice. My work with Horlicks was not just a voiceover—it was a time machine. Interested in similar storytelling for your brand? Let's have a chin-wag!\r\n<br>I voice a lot of scripts as the voice of Pathe News, Including these for <a href=\"pathe-news-jack-fm\" class=\"isred\" target=\"_blank\" title=\"Radio station Jack FM\">Radio station Jack FM</a>.</p>"}}],"$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/Hp8-la1KL6E","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","1",{"className":"inner-row reverse","children":[["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/ArEJtd9c6Uw","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2>Pitch Perfect for <span class=\"ident\">Everton FC</span> : A Voice That Scores Goals</h2>\r\n<p>When Everton Football Club sought a voice reminiscent of Harry Enfield's Cholmondeley Warner character, I was their go-to guy. I enjoyed adding vintage charm to a modern-day video presentation, connecting the fans with the players in a unique way. Need something similar? I'm just a chat away.<br>Why not check out my dedicated <a href=\"https://www.pathevoice.co.uk\" target=\"_blank\" rel=\"noopener\" title=\"Pathé News Voiceover\">Pathé News Voiceover</a> Website\r\n</p>"}}],"$undefined","$undefined","$undefined"]}]]}],["$","div","2",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2>The History of <span class=\"ident\">British Pathé</span> : A Legacy of Voices</h2>\r\n<p>As a pioneer in the film industry, Charles Pathé shaped a century of British history through newsreels, cinemagazines, and documentaries. Today, the <a class=\"ident\" href=\"https://en.wikipedia.org/wiki/Pathe_News\" target=\"_blank\" title=\"The Pathé News archiveo\">The Pathé News archive</a> serves as a digital time capsule, including the iconic voice of <a href=\"https://en.wikipedia.org/wiki/Bob_Danvers-Walker\" target= \"_blank\" title=\"Bob Danvers-Walker.\">Bob Danvers-Walker.</a> Looking to add that vintage allure to your project? Then look no further.\r\n<br>With extensive experience in this highly requested style, your project will benefit from my professional, broadcast-quality voiceover service. So don't keep calm—<a href=\"contact-guy\" title=\"Contact Guy Harris for Pathe News style voice\">contact me</a> right away for a chat about your next vintage-themed project!</p>"}}],"$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined","$undefined","$undefined",["$","img",null,{"src":"/assets/images/pathe-voice-og.jpg","alt":"Pathé News Voice – Guy Harris","style":{"width":"100%","borderRadius":4,"marginTop":8}}]]}]]}]]}]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","pathe-news-voice","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/f31072523b89a06f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en-GB","children":["$","body",null,{"children":[["$","div",null,{"className":"top-bar"}],["$","$L4",null,{}],["$","main",null,{"children":["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"404 – Page Not Found"}],["$","p",null,{"children":"Sorry, we couldn't find the page you were looking for."}]]}]}],["$","section",null,{"className":"page-content","chil