ext-col","dangerouslySetInnerHTML":{"__html":"<h2>Who Are Betfred?</h2>\r\n<p>Betfred is one of the UK’s largest bookmakers, founded in 1967 in Salford by Fred and Peter Done. Today it has thousands of shops nationwide and a huge online presence. For this campaign they wanted a bold, energetic football commentator voice, and that’s exactly what I delivered.</p>\r\n\r\n<p>If you’d like to hear more of this style, try my <a href=\"/football-commentator-voice\" title=\"Football Commentator Voice\">main football commentator voice page</a> where you’ll find extra demos and more brand examples.</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"$4"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L5",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L6",null,{"pageTitle":"Betfred Football Commentator","pageUrl":"betfred-football-commentator"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L5","989",{"href":"/cake-guy-lego-minifigure-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/cake-guy-lego-minifigure-voice.jpg","alt":"Cake Guy LEGO Minifigure Voice","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Cake Guy LEGO Minifigure Voice"}]]}],["$","$L5","679",{"href":"/batelco-wifi-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/batelco-wifi-voice.jpg","alt":"Batelco WiFi Voice","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Batelco WiFi Voice"}]]}],["$","$L5","889",{"href":"/nfl-cbs-sports-king-hen