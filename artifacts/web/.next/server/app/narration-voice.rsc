0:["wubufDEdrGena-B67LEmg",[[["",{"children":["narration-voice",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["narration-voice",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"inner-page","children":[["$","section",null,{"className":"inner-hero","children":["$","div",null,{"className":"inner-container","dangerouslySetInnerHTML":{"__html":"<h1><span class=\"ident\">Narration</span> Voiceover</h1>\r\n<p>I've spent 16+ years in narration. Book a voice with experience and credibility. A voice that can relate to your product.<br>\r\nWhether it's a corporate film, a <a href=\"/explainer-video-voice\" title=\"Explainer Video Voice\" class=\"isred\">web explainer video</a>, or a brand documentary, the voice you choose represents your brand. Don’t fall into the trap of allowing any voice to do it at the expense of cost.</p>"}}]}],["$","div",null,{"className":"inner-bar"}],["$","div",null,{"className":"inner-parallax","children":["$","div",null,{"className":"inner-container","children":[[["$","div","0",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2><span class=\"ident\">Choosing </span>the Narrator</h2>\r\n<p>The narrator is a personal character or a non-personal voice that the creator of the story develops to deliver information to the audience, particularly about the plot. When it comes to the image of a company and you’ve spent all that time and effort creating your awesome brand, don’t settle for anything less than the best.<br>\r\nThis is a job was to promote water usage and where it comes from.\r\n</p>"}}],"$undefined","$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/N4cZtq6UBRI","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","1",{"className":"inner-row reverse","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2>Trust a voice with<span class=\"ident\"> Experience.</span></h2>\r\n<p>Book a voice with credibility. A voice that fits well with your product, brand and message.<br>\r\nFrom <a href=\"/david-attenborough-voice\" title=\"David Attenborough Voice\" class=\"isred\">Attenborough-style documentary narration</a> to <a href=\"/commercial-voiceover\" title=\"Commercial Voiceover\" class=\"isred\">commercial reads</a> and <a href=\"/apple-voice-style\" title=\"Apple Voice Style\" class=\"isred\">Apple-style narration</a>, don't allow cost to stand in the way of the right choice. I will never take a job unless I'm 100% right for it.<br>\r\nThis is a great animation to promote media monitoring company PhoenixPB. They and myself were very happy with the end result. \r\n</p>"}}],"$undefined","$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/22hxKsJPEpI","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","2",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2>How<span class=\"ident\"> Easy?</span></h2>\r\n<p>Let me give you a custom read first. Sure, I can send you regular demo, but a bespoke version gives you a better idea of how my voice fits with your brand.<br>\r\nOnce you have the final approved script, a high quality WAV is delivered back to you the same day, (99% of the time) edited and de breathed should you require.<br>\r\nThe quote can also include amends or minor pick ups too. \r\n<a href=\"/contact-guy\" class=\"isred\" target=\"_blank\" title=\"Get in touch via the contact page\">Get in touch</a> now and lets get started.\r\n</p>"}}],"$undefined","$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined","$undefined","$undefined",["$","div",null,{"className":"blog-post-img-card","children":[["$","img",null,{"src":"/assets/images/narration-voice-og.webp","alt":"Narration Voice – Guy Harris","className":"blog-post-img"}],["$","p",null,{"className":"blog-post-img-caption","children":"Narration Voice – Guy Harris"}]]}]]}]]}]],["$","$L2",null,{"pageTitle":"Narration Voiceover – Natural English Voice","pageUrl":"https://www.voiceoverguy.co.uk/narration-voice","intro":"Looking for warm, natural narration? Send me a quick message and I'll get back to you."}]]}]}],[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ProfilePage\",\"@id\":\"https://www.voiceoverguy.co.uk/narration-voice#profilepage\",\"url\":\"https://www.voiceoverguy.co.uk/narration-voice\",\"mainEntity\":{\"@type\":\"Person\",\"@id\":\"https://www.voiceoverguy.co.uk/#guyharris\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk\",\"image\":\"https://www.voiceoverguy.co.uk/images/guy-harris-profile.jpg\",\"jobTitle\":\"British Male Voiceover Artist\",\"sameAs\":[\"https://www.linkedin.com/in/voiceoverguy/\",\"https://www.youtube.com/user/voiceoverguyharris\"],\"description\":\"Guy Harris is a professional British narration voiceover artist for corporate videos, e-learning and documentary content.\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/narration-voice#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@id\":\"https://www.voiceoverguy.co.uk/\",\"name\":\"Home\"}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@id\":\"https://www.voiceoverguy.co.uk/narration-voice\",\"name\":\"Narration Voice\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/narration-voice#video\",\"name\":\"Narration Voiceover – Natural English Voice\",\"description\":\"Narration voiceover demo by Guy Harris, a natural English voice for corporate and e-learning projects.\",\"thumbnailUrl\":\"https://img.youtube.com/vi/N4cZtq6UBRI/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/N4cZtq6UBRI\",\"url\":\"https://www.youtube.com/watch?v=N4cZtq6UBRI\",\"uploadDate\":\"2016-02-17T00:00:00+00:00\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"@id\":\"https://www.voiceoverguy.co.uk/narration-voice#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What types of narration does Guy Harris offer?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Guy Harris provides narration voiceovers for corporate videos, health & safety training, documentaries, and e-learning content. His delivery is clear, warm, and authoritative—perfect for professional projects.\"}},{\"@type\":\"Question\",\"name\":\"Can I direct a narration session live with Guy?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Guy’s broadcast-quality studio supports live direction via Cleanfeed, Source Connect, or Zoom, so you can guide the session and get exactly the tone you need.\"}},{\"@type\":\"Question\",\"name\":\"Where is Guy Harris based?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Guy is a professional British voiceover artist based in Wakefield, West Yorkshire, offering narration services to clients across the UK and internationally.\"}}]}"}}]]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","narration-voice","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/d67bbeffc4afbc33.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en-GB","children":[["$","head",null,{"children":[["$","link",null,{"rel":"icon","href":"/favicon.ico","sizes":"any"}],["$","link",null,{"rel":"icon","href":"/assets/images/voiceover-guy-icon.webp","type":"image/png"}],["$","link",null,{"rel":"apple-touch-icon","href":"/assets/images/voiceover-guy-icon.webp"}]]}],["$","body",null,{"children":[["$","div",null,{"className":"top-bar"}],["$","$L5",null,{}],["$","main",null,{"children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"404 – Page Not Found"}],["$","p",null,{"children":"Sorry, we couldn't find the page you were looking for."}]]}]}],["$","section",null,{"className":"page-content","children":["$","div",null,{"className":"container","style":{"textAlign":"center","padding":"60px 15px"},"children":[["$","p",null,{"style":{"fontSize":"16px","marginBottom":"24px"},"children":"The page you're looking for may have moved, been renamed, or doesn't exist."}],["$","$L6",null,{"href":"/","className":"cta-btn","children":"Back to Home"}]," ",["$","$L6",null,{"href":"/contact-guy","className":"cta-btn-outline","style":