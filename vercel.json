    { "source": "/guy-harris-voiceover", "destination": "https://www.voiceoverguy.co.uk/voiceoverguy", "statusCode": 301 },
    { "source": "/studio-hire", "destination": "https://www.voiceoverguy.co.uk/voiceover-studio", "statusCode": 301 },
    { "source": "/nightmare-horror-adventures-spooky-voice", "destination": "https://www.voiceoverguy.co.uk/", "statusCode": 301 },
    { "source": "/who", "destination": "https://www.voiceoverguy.co.uk/", "statusCode": 301 },
    { "source": "/experian-explainer-video", "destination": "https://www.voiceoverguy.co.uk/", "statusCode": 301 },
