fined"]}],["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<h2>Common Questions About My Attenborough Voice</h2>\r\n<p><strong>Is David Attenborough’s voice AI?</strong> No. While there are <a href=\"ai-guy-human-vs-ai-voiceover\" title=\"AI Voices\">AI</a> versions out there, my impression is a natural performance, grounded in years of professional voiceover experience. I deliver nuance, timing and warmth that no algorithm can fully capture.</p>\r\n\r\n<p><strong>Where have people heard your Attenborough impression?</strong> Across TV, games, trailers, social virals, and more. From <a href=\"turkish-bird-attenborough-voice\" title=\"Social Media Attenborough\">lighthearted social media videos</a> to serious narration worldwide.</p>\r\n\r\n<p><strong>Can you record live with direction?</strong> Absolutely. I record with clients over <a href=\"voiceover-studio\" title=\"Booking Attenborough with Zoom or Cleanfeed\">Zoom or Cleanfeed</a>, so you can direct in real time. The final read is then exactly as you imagined it. All delivered in broadcast-quality audio the same day.</p>"}}],"$undefined","$undefined","$undefined"]}]]}],["$","div","2",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<h2>Ready to Book a David Attenborough Voice?</h2>\r\n<p>Want to play around with the style yourself?<br>Try my <a href=\"attenborough-script-generator\" title=\"attenborough script generator\">David Attenborough Script Generator</a> for fun, AI-powered scripts. It’s a fun way to test script writing, but if your project matters, let’s keep it <strong>Human First</strong>.<br>If you’re after a respectful <strong>David Attenborough impersonator</strong>, whether serious narration or spoof comedy, drop me a message and I’ll send you a quick free sample before you commit. Most scripts are voiced the same day.</p>"}}],"$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined","$undefined","$undefined",["$","img",null,{"src":"/assets/images/attenborough-script-generator.jpg","alt":"David Attenborough Impression – Guy Harris","style":{"width":"100%","borderRadius":4,"marginTop":8}}]]}]]}]]}]}]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","david-attenborough-voice","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/f31072523b89a06f.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en-GB","children":["$","body",null,{"children":[["$","div",null,{"className":"top-bar"}],["$","$L5",null,{}],["$","main",null,{"children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"404 – Page Not Found"}],["$","p",null,{"children":"Sorry, we couldn't find the page you were looking for."}]]}]}],["$","section",null,{"className":"page-content","children":["$","div",null,{"className":"container","style":{"textAlign":"center","padding":"60px 15px"},"children":[["$","p",null,{"style":{"fontSize":"16px","marginBottom":"24px"},"children":"The page you're looking for may have moved, been renamed, or doesn't exist."}],["$","$L6",null,{"href":"/","className":"cta-btn","children":"Back to Home"}]," ",["$","$L6",null,{"href":"/contact-guy","className":"cta-btn-outline","style":{"marginLeft":"12px"},"children":"