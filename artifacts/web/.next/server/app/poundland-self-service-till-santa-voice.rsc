0:["-I7cAKaR5Wzfc67K4RiE3",[[["",{"children":[["slug","poundland-self-service-till-santa-voice","d"],{"children":["__PAGE__?{\"slug\":\"poundland-self-service-till-santa-voice\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","poundland-self-service-till-santa-voice","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/poundland-self-service-till-santa-voice#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Self Service Till Santa for Poundland\",\"item\":\"https://www.voiceoverguy.co.uk/poundland-self-service-till-santa-voice\"}]}"}}],["$","script","schema-2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/poundland-self-service-till-santa-voice#video\",\"name\":\"Self Service Till Santa for Poundland\",\"thumbnailUrl\":\"https://img.youtube.com/vi/gJ_hT3RLhfw/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/gJ_hT3RLhfw\",\"author\":{\"@type\":\"Person\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk/voiceoverguy\",\"image\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-profile.jpg\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"VoiceoverGuy\",\"url\":\"https://www.voiceoverguy.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.png\"}},\"inLanguage\":\"en-GB\",\"description\":\"Poundland Self Service Till Santa Voice - The UK's favourite and busiest voice of Santa and part of the Poundland till controversy. Need a Santa? Get in touch.\",\"uploadDate\":\"2020-12-01T00:00:00+00:00\"}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"Self Service Till Santa for Poundland"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>Poundland and Everyone's Voice of Santa</p>\r\n<p>From Heart Radio, Santa Radio and BBC Radio 2, my Santa is heard across the globe in almost as many places as Santa delivers too. <br>However in 2020 Santa got into trouble at Poundland. Read on...</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main two-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>The UK's favourite voice of Santa</h2>\r\n<p>It seems these days I'm the voice of Santa for everyone. Including Heart Radio, <a href=\"/https://www.santaradio.co.uk\" target=\"_blank\" title=\"Santa Radio Website\">Santa Radio</a> and of course BBC Radio 2 and the <a href=\"/https://www.youtube.com/watch?v=5o9Va4YsI3g\" target=\"_blank\" title=\"Zoe Ball breakfast show Santa\">Zoe Ball breakfast show</a> Santa. So, I can safely say, if you need the voice of Santa, you are in safe gloves and you'll have that authentic ho ho ho and deep warm Santa everyone knows and loves. From national radio stations to small events, drop me the script and details and let me get to the workshop and voice it.\r\n</p>"}}],false,["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/gJ_hT3RLhfw","title":"Self Service Till Santa for Poundland","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}]}]]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/poundland-self-service-till-santa-voice.jpg","alt":"poundland-self-service-till-santa-voice","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>Santa in trouble at Poundland</h2>\r\n<p>Oh no. December 2020 saw an influx of national publications reporting on a story of a lady offended because Santa announced her credit card was not accepted on the Poundland self service tills. To be honest a bit of a non story as clearly a sense of humour breakdown. I was happy to say, listening to the film, it was my voice. Besides making it into aarious papers and websites globally it was also picked up on Have I got New for you on the BBC. Thank you! I'll take the Paul Merton quote \"Thats Father Christmas\". Brilliant PR.\r\n</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Do you fancy a Santa voice?</h2>\r\n<p>Maybe with less controversy, if my voice of Santa can help then please feel free to <a href=\"/contact-guy\" title=\"Contact Guy\">get in touch</a>. If you need a little reassurance that my Santa is right for your festive project, I am happy to provide a short sample from your script. Either way, lets make it sound Epic!</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"Self Service Till Santa for Poundland","pageUrl":"poundland-self-service-till-santa-voice"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[