0:["uZlw_rSN16EBLe2H5Gx5t",[[["",{"children":[["slug","salter-blender-pro","d"],{"children":["__PAGE__?{\"slug\":\"salter-blender-pro\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","salter-blender-pro","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/salter-blender-pro#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Salter Blender Pro\",\"item\":\"https://www.voiceoverguy.co.uk/salter-blender-pro\"}]}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"Salter Blender Pro"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>The Salter Blender Pro is an awesome bit of kit.</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main one-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>Check out the video</h2>\r\n<br>\r\n<p>I've been working with Ultimate Products for a while now and it's always much nicer when the products I'm voicing are ones I'd actually buy.  This blender is great and I love how the video came out. I also voiced the <a href=\"/https://www.youtube.com/watch?v=6RKxbr0D9uk\" target=\"_blank\" title=\"Salter Pan for Life\">Salter Pan for Life</a> ad and I hope to work with them in the future. Bigger brands, like Salter, often need a bigger, more recognisable voice, so I'm very pleased they chose to work with me!</p>"}}],false,false]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/salter-blender-pro.jpg","alt":"Salter Blender Pro","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>A Little More about Salter</h2>\r\n<p>The Salter Blender Pro 1500 is a high performance blender. With its stainless steel blades which are supercharged with 1500w of power, spinning at 25,000 RPM, you can smash, blend, grind and whip up many different foods, drinks, glazes, spices, and soups with ease.</em> Salter is widely regarded as one of the top kitchen and catering specialist companies in the World</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Get in touch</h2>\r\n<p>Got a <a href=\"/commercial-voiceover\" title=\"Commercial Voiceover\">commercial</a> or <a href=\"/explainer-video-voice\" title=\"Explainer Video Voiceover\">explainer video</a> in need of a voice? Maybe one like this one for Salter? Please get in touch. To make the process even easier, just let me know the intended usage of the tv advert and I can quote you more accurately. Feel free to send a short sample of the script and I'd be more than happy to send you a short audition to check if my voice is right for your show or project.</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"Salter Blender Pro","pageUrl":"salter-blender-pro"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$