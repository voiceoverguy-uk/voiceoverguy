2:T4a7,{"@context":"https://schema.org","@type":"BlogPosting","@id":"https://www.voiceoverguy.co.uk/voice-over-word-count-calculator#blogposting","mainEntityOfPage":"https://www.voiceoverguy.co.uk/voice-over-word-count-calculator","headline":"Voice-Over - Time Word Count Calculator","url":"https://www.voiceoverguy.co.uk/voice-over-word-count-calculator","author":{"@type":"Person","name":"Guy Harris","url":"https://www.voiceoverguy.co.uk/voiceoverguy","image":"https://www.voiceoverguy.co.uk/assets/images/guy-harris-profile.jpg"},"publisher":{"@type":"Organization","name":"VoiceoverGuy","url":"https://www.voiceoverguy.co.uk","logo":{"@type":"ImageObject","url":"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.png"}},"inLanguage":"en-GB","isAccessibleForFree":true,"description":"Estimate your voice-over speaking time with our word count calculator. Get fast and accurate results for slow, normal, and fast speaking rates. Try it now! ","datePublished":"2023-03-01T00:00:00+00:00","dateModified":"2023-03-01T00:00:00+00:00","keywords":["voiceover"],"image":{"@type":"ImageObject","url":"https://www.voiceoverguy.co.uk/assets/img/blog/voice-over-word-count-calculator.jpg"}}3:T57f,<html>
<head>
	<title>Word Count to Speaking Time Calculator</title>
</head>
<body>
	<h1><center>Word Count to Speaking Time Calculator</center></h1>
	<p><h2><center><b>Enter the number of words in your script:</b></center></h2></p>
	<center><input type="number" id="wordCount">
	<button onclick="calculate()">Calculate</button></center>
	<p><h3><center><b>Estimated speaking time:</b></center></h3></p><br>
	<ul>
		<li><strong>Slow:</strong> <span id="slowTime"></span></li>
		<li><strong>Normal:</strong> <span id="normalTime"></span></li>
		<li><strong>Fast:</strong> <span id="fastTime"></span></li>
	</ul>

	<script>
		function calculate() {
			const wordCount = document.getElementById("wordCount").value;
			const slowTime = (wordCount / 100);
			const normalTime = (wordCount / 150);
			const fastTime = (wordCount / 200);
			document.getElementById("slowTime").innerHTML = formatTime(slowTime);
			document.getElementById("normalTime").innerHTML = formatTime(normalTime);
			document.getElementById("fastTime").innerHTML = formatTime(fastTime);
		}
		
		function formatTime(time) {
			const minutes = Math.floor(time);
			const seconds = Math.round((time - minutes) * 60);
			return minutes + " minute" + (minutes == 1 ? "" : "s") + ", " + seconds + " second" + (seconds == 1 ? "" : "s");
		}
	</script>
<br>(coming soon, enter your cost per word)
</body>
</html>7:["slug","voice-over-word-count-calculator","d"]
