0:["XPBGwEKvr8cwSZUTNZgMN",[[["",{"children":[["slug","world-of-warships-tutorial-voice","d"],{"children":["__PAGE__?{\"slug\":\"world-of-warships-tutorial-voice\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","world-of-warships-tutorial-voice","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/world-of-warships-tutorial-voice#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"World of Warships Tutorial Voice\",\"item\":\"https://www.voiceoverguy.co.uk/world-of-warships-tutorial-voice\"}]}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"World of Warships Tutorial Voice"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>The hit game World of Warships asked me to voice all the Naval academy video tutorials. of course I said yes.</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main one-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>Video game voices</h2>\r\n<p>It's been fun working on this collection of videos. As the game continues to get bigger hopefully the Naval academy will keep me as the captain of their updates. I'm used to shorter <a href=\"/commercial-voiceover\" target=\"_blank\" title=\"Commercial Voiceover\">TV ads</a>, <a href=\"/explainer-video-voice\" title=\"Explainer Video Voiceover\">explainer videos</a>, and <a href=\"/game-trailer-voice\" title=\"Game Trailer Voiceover\">game trailers</a>, so it's a breath of fresh air to spend more time proving voiceover for World of Warship's tutorials. There is so much detail in this tutorial and I think I've made the information as easy as possible to absorb.</p>"}}],false,false]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/world-of-warships-tutorial-voice.jpg","alt":"World of Warships Tutorial Voice","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<br>\r\n<h2>What is World of Warships?</h2>\r\n<br>\r\n<p><a href=\"https://worldofwarships.eu\" target=\"_blank\" title=\"World of Warships\" rel=\"noopener noreferrer\">World of Warships</a> is a naval action-themed massively multiplayer online game produced by international game developer and publisher <a href=\"https://wargaming.net/en\" target=\"_blank\" title=\"Wargaming\" rel=\"noopener noreferrer\">Wargaming</a>, which is headquartered in Nicosia, Cyprus. Wargaming is a great company and it was great to work with them on this longer voiceover project\r\n</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Get in touch</h2>\r\n<p>I'm very comfortable with regular work and if you need fast delivery like the regular updates for World of Warships tutorial voice, so if you are looking for a voice to be available daily and to deliver last minute, then please feel free to get in touch. To make the process even easier, just let me know the intended usage of the project and I can quote you more accurately. Feel free to send a short sample of the script and I'd be more than happy to send you a short audition to check if my voice is right for your show or project.</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"World of Warships Tutorial Voice","pageUrl":"world-of-warships-tutorial-voice"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","797",{"href":"/guide-to-becoming-a-voiceover-artist","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/guide-to-becoming-a-voiceover-artist.jpg","alt":"Guide to Becoming a Voiceover Artist","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Becoming a Voiceover Artist?"}]]}],["$","$L3","949",{"href":"/13-dead-end-drive-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/13-dead-end-drive-voiceover.jpg","alt":"13-dead-end-drive-voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"13 Dead End Drive Voiceover"}]]}],["$","$L3","607",{"href":"/robocide-game-trailer-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/robocide-game-trailer-voice.jpg","alt":"Robocide Game Trailer Voice","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Robocide Game Trailer Voice"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$un