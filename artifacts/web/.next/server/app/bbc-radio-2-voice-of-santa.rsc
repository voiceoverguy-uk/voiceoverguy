0:["wubufDEdrGena-B67LEmg",[[["",{"children":[["slug","bbc-radio-2-voice-of-santa","d"],{"children":["__PAGE__?{\"slug\":\"bbc-radio-2-voice-of-santa\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","bbc-radio-2-voice-of-santa","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/bbc-radio-2-voice-of-santa#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Voice of Santa for BBC Radio 2\",\"item\":\"https://www.voiceoverguy.co.uk/bbc-radio-2-voice-of-santa\"}]}"}}],["$","script","schema-2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/bbc-radio-2-voice-of-santa#video\",\"name\":\"Voice of Santa for BBC Radio 2\",\"thumbnailUrl\":\"https://img.youtube.com/vi/Qqu-HDA2KJE/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/Qqu-HDA2KJE\",\"author\":{\"@type\":\"Person\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk/voiceoverguy\",\"image\":\"https://www.voiceoverguy.co.uk/images/guy-harris-profile.jpg\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"VoiceoverGuy\",\"url\":\"https://www.voiceoverguy.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.webp\"}},\"inLanguage\":\"en-GB\",\"uploadDate\":\"2024-12-01T00:00:00+00:00\",\"description\":\"BBC Radio 2 Voice of Santa. In the Air and On the Air for Zoe Ball and the team at Christmas. Father Christmas even chats with Zoe on Christmas Eve.\"}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container page-header-nav-wrap","children":[["$","div",null,{"className":"page-header-content","children":[["$","h1",null,{"children":"Voice of Santa for BBC Radio 2"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p style=\"font-size: 18px;\">\r\nAs heard across the UK on <a href=\"https://www.bbc.co.uk/sounds\" target=\"_blank\" style=\"color: #0073e6;\" rel=\"noopener noreferrer\">BBC Radio 2</a>, Ho Ho Ho, it's Father Christmas, aka Santa!<br>\r\nI’m Guy Harris, the official <strong>Voice of Santa</strong>, bringing festive cheer to the nation’s favorite radio station each Christmas season.\r\n</p>"}}]]}],["$","div",null,{"className":"page-header-arrows","children":[["$","$L3",null,{"href":"/crowd-hub-x-explainer-video-voiceover","className":"page-header-arrow","title":"Crowd Hub X Explainer Voice","aria-label":"Previous: Crowd Hub X Explainer Voice","children":"‹"}],["$","$L3",null,{"href":"/spooky-halloween-laughs","className":"page-header-arrow","title":"A collection of Halloween Laughs","aria-label":"Next: A collection of Halloween Laughs","children":"›"}]]}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main two-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2 style=\"font-size: 24px; color: #AD030C;\">The Voice of Santa for BBC Radio 2</h2>\r\n\r\n<p style=\"font-size: 18px;\">\r\nEven Santa needs a little help now and then! When he can’t be everywhere at once, he outsources his voice work, and I’m delighted to step in.<br>\r\nSanta takes to the airwaves with Zoe Ball on <a href=\"https://www.bbc.co.uk/sounds\" target=\"_blank\" style=\"color: #0073e6;\" rel=\"noopener noreferrer\">BBC Radio 2</a> each Christmas, spreading festive magic to listeners across the UK.\r\n</p>\r\n\r\n<p style=\"font-size: 18px;\">\r\nIt’s always a pleasure working with the BBC, bringing the voice of Father Christmas to life and adding that extra sparkle to their December broadcasts.<br>\r\n</p>"}}],false,["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/Qqu-HDA2KJE","title":"Voice of Santa for BBC Radio 2","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}]}]]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"blog-post-img-card","children":[["$","img",null,{"src":"/assets/img/blog/bbc-radio-2-voice-of-santa.jpg","alt":"bbc-radio-2-voice-of-santa","className":"blog-post-img"}],["$","p",null,{"className":"blog-post-img-caption","children":"Voice of Santa for BBC Radio 2"}]]}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2 style=\"font-size: 24px; color: #AD030C;\">Father Christmas Voice</h2>\r\n\r\n<p style=\"font-size: 18px;\">\r\nWhen you imagine Father Christmas, you think of a jolly old fella with a warm, deep, and welcoming voice. That’s exactly what I deliver, but with a little cheeky charm!<br>\r\n</p>\r\n\r\n<p style=\"font-size: 18px;\">\r\nI’d love the opportunity to bring Santa to life in more animated productions. If you’re looking for an authentic and engaging <strong>Father Christmas voice</strong> for your next project, <a href=\"mailto:guy@voiceoverguy.co.uk\" style=\"color: #0073e6;\">get in touch</a> today. Let’s create something magical together!\r\n</p>\r\n"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"$4"}}],["$","div",null,{"className":"blog-