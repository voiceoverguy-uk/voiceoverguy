0:["PTF5f6zbP51hXl6zOpnuH",[[["",{"children":["movie-trailer-voice",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["movie-trailer-voice",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"inner-page","children":[["$","section",null,{"className":"inner-hero","children":["$","div",null,{"className":"inner-container","dangerouslySetInnerHTML":{"__html":"<h1>The <span class=\"ident\">Movie Trailer</span> voice</h1>\r\n<p>My Movie Trailer Voice is heard worldwide on TV & Radio including BBC Sport, BBC Radio 1 and many Game Trailers.<br>\r\nThe style has been around for years. That deep epic voice made famous by the late great Don La Fontaine and Hal Douglas.<br>\r\n</p>"}}]}],["$","div",null,{"className":"inner-bar"}],["$","div",null,{"className":"inner-parallax","children":["$","div",null,{"className":"inner-container","children":[[["$","div","0",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2><span class=\"ident\">In a World… One Man...</span> One Voice…</h2>\r\n<p>My movie voice is regularly used on radio commercials and Movie Trailers on YouTube and the small screen too across the world.<br>\r\nThe Big Trailer Voice that makes you wanna watch that film or… buy YOUR Product! <br>\r\nDespite being British I can give you an American and English Movie Trailer Voice. Let me know what you prefer and if it helps, send me some lines and I'll send you a custom sample first. So we know I'm the right voice for the project.<br>\r\nLet me enhance your production, film or event. <br>\r\nGet in touch below and tell me more!</p>"}}],"$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/Cncd3VgDQ9s","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","1",{"className":"inner-row reverse","children":[["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/18oOI8mHZzs","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/embrh2Y5VjI","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","2",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><br><h2>How to order your <span class=\"ident\">Movie Trailer Voice</span></h2>\r\n<p>The Movie Trailer Voice became so popular I set up <span class=\"ident\">The Movie Trailer Voice Cuts</span> website allowing you to purchase a stack of mp3 Movie Trailer Voice Cliches. <br>\r\nMovie voice cuts in high quality you can use on personal productions. Simply drag the files onto your timeline and start editing. Works great in Final Cut ProX, Adobe Premier and many other video editors.<br>\r\nFor commercial use and bespoke lines for your project<br>please visit <a href=\"/contact-guy\" class=\"isred\" target=\"_blank\" title=\"The Movie Trailer Voice - Book here\">the contact us page</a> and tell us more. Please give as much detail as you can including usage and script length. This allows for a more accurate quote quickly.</p>"}}],"$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/bcCpLnX-1ck","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","3",{"className":"inner-row reverse","children":[["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/lw3_DUx5jrk","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined","$undefined","$undefined",["$","img",null,{"src":"/assets/images/movie-trailer-voice-og.jpg","alt":"Movie Trailer Voice – Guy Harris","style":{"width":"100%","borderRadius":4,"marginTop":8}}]]}]]}]],["$","$L2",null,{"pageTitle":"Movie Trailer Voice - In a World - Imaging & Trailers","pageUrl":"https://www.voiceoverguy.co.uk/movie-trailer-voice"}]]}]}],[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"@id\":\"https://www.voiceoverguy.co.uk/movie-trailer-voice#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can I hire Guy Harris for a movie trailer voiceover?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Guy Harris provides movie trailer-style voiceovers for TV, radio, film, events, and online use. His voice has been featured in campaigns for BBC, ITV, and major games and promos.\"}},{\"@type\":\"Question\",\"name\":\"What styles of movie trailer voice can Guy deliver?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Guy can deliver both UK and US-style movie trailer voices, ranging from deep dramatic tones to parody-style trailers with impact.\"}},{\"@type\":\"Question\",\"name\":\"Where is Guy’s voiceover studio located?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Guy records from his professional studio in Wakefield, West Yorkshire. Sessions can be directed live via Source Connect, Cleanfeed, or Zoom.\"}}]}"}}]]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","movie-trailer-voice","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/ac5a13a32dde8802.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en-GB","children":[["$","head",null,{"children":[["$","link",null,{"rel":"icon","href":"/favicon.ico","sizes":"any"}],["$","link",null,{"rel":"icon","href":"/assets/images/voiceover-guy-icon.png","type":"image/png"}],["$","link",null,{"rel":"apple-touch-icon","href":"/assets/images/voiceover-guy-icon.png"}]]}],["$","body",null,{"children":[["$","div",null,{"className":"top-bar"}],["$","$L5",null,{}],["$","main",null,{"children":["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"404 – Page Not Found"}],["$","p",null,{"children":"Sorry, we couldn't find the page you were looking for."}]]}]}],["$","section",null,{"className":"page-content","children":["$","div",null,{"className":"container","style":{"textAlign":"center","padding":"60px 15px"},"children":[["$","p",null,{"style":{"fontSize":"16px","marginBottom":"24px"},"children":"The page 