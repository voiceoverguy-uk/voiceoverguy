0:["wubufDEdrGena-B67LEmg",[[["",{"children":[["slug","voice-of-venom","d"],{"children":["__PAGE__?{\"slug\":\"voice-of-venom\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","voice-of-venom","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/voice-of-venom#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"The Voice of Venom\",\"item\":\"https://www.voiceoverguy.co.uk/voice-of-venom\"}]}"}}],["$","script","schema-2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/voice-of-venom#video\",\"name\":\"The Voice of Venom\",\"thumbnailUrl\":\"https://img.youtube.com/vi/Qnr7JE3WeI8/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/Qnr7JE3WeI8\",\"author\":{\"@type\":\"Person\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk/voiceoverguy\",\"image\":\"https://www.voiceoverguy.co.uk/images/guy-harris-profile.jpg\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"VoiceoverGuy\",\"url\":\"https://www.voiceoverguy.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.webp\"}},\"inLanguage\":\"en-GB\",\"uploadDate\":\"2025-06-01T00:00:00+00:00\",\"description\":\"I recreated the voice of Venom using only my vocal cords. No effects, no AI. Watch it now and explore more of my gritty, monstrous character voice work.\"}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container page-header-nav-wrap","children":[["$","div",null,{"className":"page-header-content","children":[["$","h1",null,{"children":"The Voice of Venom"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>What happens when a voiceover artist watches Venom 1 & 2 back-to-back? He ends up trying to summon a gravelly alien symbiote voice from the depths of his stomach. Spoiler: I did… and it worked.</p>"}}]]}],["$","div",null,{"className":"page-header-arrows","children":[["$","$L3",null,{"href":"/nuby-commentator-voice","className":"page-header-arrow","title":"Midnight Mayhem! Nuby’s Milk Race","aria-label":"Previous: Midnight Mayhem! Nuby’s Milk Race","children":"‹"}],["$","$L3",null,{"href":"/hide-the-corpse-promo-voiceover","className":"page-header-arrow","title":"Promo Voiceover - Patrick Stewart Style","aria-label":"Next: Promo Voiceover - Patrick Stewart Style","children":"›"}]]}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main two-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2><strong>The Voice That Growls From the Shadows</strong></h2>\r\n<p>Tom Hardy’s performance as Venom is iconic, not just visually, but vocally. The voice of Venom is deep, textured, and almost otherworldly. I was hooked. So, I set myself a challenge: could I recreate that voice?</p>\r\n<p>Venom’s just one of many characters living in my head. From goblins and wise old wizards to pirates, gameshow hosts, and Santa himself, I’ve got a full voice cast ready to go. </p>"}}],false,["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/Qnr7JE3WeI8","title":"The Voice of Venom","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}]}]]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"blog-post-img-card","children":[["$","img",null,{"src":"/assets/img/blog/Voice of Venom.jpg","alt":"Marvel Voice of Venom","className":"blog-post-img"}],["$","p",null,{"className":"blog-post-img-caption","children":"The Voice of Venom"}]]}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2><strong>Learning the Venom Voice – My Process</strong></h2>\r\n<p>I didn’t study scripts or use fancy software. I simply watched. I listened. I mimicked. It’s all about getting the <em>weight</em> of the voice right. That dark resonance comes from way down, past the chest, somewhere near your lunch. I reached deep and channelled that monstrous tone, layering in menace and rhythm. Just me and a mic.</p>\r\n<p><a href=\"https://www.voiceoverguy.co.uk/character-voiceover\" target=\"_blank\" rel=\"noopener noreferrer\">Visit my Character Voiceover page</a> to dive into my portfolio of playful, powerful, and peculiar performances.</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2><strong>Need a Voice That’s Not of This World?</strong></h2>\r\n<p>If you’re looking for a voice that’s dark, gritty, and instantly unforgettable, I’d love to help bring your project to life. Whether it’s for a villain, a trailer, or a unique campaign… I’ve got the voice. Get in touch today.</p>\r\n<p><a href=\"mailto:guy@voiceoverguy.co.uk?subject=Voiceover%20Enquiry%20–%20Venom%20Style\">📩 Contact Me Here</a></p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"The Voice of Venom","pageUrl":"voice-of-venom"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","590",{"href":"/the-escapists-game-trailer","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/the-escapists-game-trailer.jpg","alt":"The Escapists Game Trailer","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"The Escapists Game Trailer"}]]}],["$","$L3","809",{"href":"/which-recording-studio-software-is-best","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/which-recording-studio-software-is-best.jpg","alt":"Which Recording Studio Software is Best?","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"The Best Recording Studio Software?"}]]}],["$","$L3","959",{"href":"/arabella-harris-girl-child-voiceover-kid","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/arabella-harris-voiceover-kid.jpg","alt":"Arabella Harris British Girl Child Voiceover Kid","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Arabella Harris – Child Girl Voiceover Artist"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/d67bbeffc4afbc33.css","precedence":"next","crossOrigin"