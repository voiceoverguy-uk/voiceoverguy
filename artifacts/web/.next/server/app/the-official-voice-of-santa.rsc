0:["-I7cAKaR5Wzfc67K4RiE3",[[["",{"children":[["slug","the-official-voice-of-santa","d"],{"children":["__PAGE__?{\"slug\":\"the-official-voice-of-santa\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","the-official-voice-of-santa","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/the-official-voice-of-santa#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Guy Harris is the Official Voice of Santa\",\"item\":\"https://www.voiceoverguy.co.uk/the-official-voice-of-santa\"}]}"}}],["$","script","schema-2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/the-official-voice-of-santa#video\",\"name\":\"Guy Harris is the Official Voice of Santa\",\"thumbnailUrl\":\"https://img.youtube.com/vi/Qqu-HDA2KJE/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/Qqu-HDA2KJE\",\"author\":{\"@type\":\"Person\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk/voiceoverguy\",\"image\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-profile.jpg\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"VoiceoverGuy\",\"url\":\"https://www.voiceoverguy.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.png\"}},\"inLanguage\":\"en-GB\",\"description\":\"Guy is considered the ORIGINAL official voice of Santa, delivering his classic Santa voiceover on CBBC, BBC R2, ITV, This Morning, & more! Accept no substitute!\",\"uploadDate\":\"2019-11-01T00:00:00+00:00\"}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"Guy Harris is the Official Voice of Santa"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>My Santa voiceover has become one of my most requested jobs! As heard on the Telly, Radio and Events globally.</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main two-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>Claiming the Position as the \"Official\" Voice of Santa</h2>\r\n<p>With the sad lack of an official body to designate the undisputed voice of Santa, I think us voiceover artists need to act with our initiative. I have performed more Santa voiceovers than perhaps any other voice, and I love every minute of it. As such, this Christmas I've decided to give myself the crown and declare myself the official voice of Santa. Think this is a bit much? I might be inclined to agree with you, only I've performed the voice of Santa so many times I'm almost turning into the big man in red! Here is just a snippet of how my Santa voiceover is used. Yes, Santa for Zoe Ball's breakfast show on BBC Radio 2. <br>Click if you would you like a <a href=\"/https://www.santaradio.co.uk/personalised-santa-message/all\" target=\"_blank\" title=\"FREE Personal message from Santa\">FREE Personal message from Santa</a>.</p>"}}],false,["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/Qqu-HDA2KJE","title":"Guy Harris is the Official Voice of Santa","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}]}]]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/official-voice-of-santa-guy-harris.jpg","alt":"the-official-voice-of-santa","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<p><a href=\"/https://www.youtube.com/watch?v=yi-4Fm40nmE\" target=\"_blank\" title=\"CBBC Santa Voice\">CBBC</a>, This Morning, Loose Women, HEART Radio, Bauer Radio Stations, hundreds of radio stations, in fact, <a href=\"/https://www.santaradio.co.uk/\" target=\"_blank\" title=\"Santa Radio\">Santa Radio</a>, Santa's voice a the Poundland tils (that's really me!), Not forgetting <a href=\"/bbc-radio-2-voice-of-santa\" target=\"_blank\" title=\"BBC Radio 2 Santa Voice\">BBC Radio 2</a>. Honestly, that's not even all of them; I'm just exhausted trying to find everything! I love being the voice of Santa and it's my hope that my move to crown myself the official voice of Santa will encourage more brands and production companies to get in touch. Nothing gets me in the Chrismtas spirit quite like doing an impression of old Father Christmas himself!</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Get in touch!</h2>\r\n<p>Do you need the voice of Christmas for your next <a href=\"/commercial-voiceover\" target=\"_blank\" title=\"Commercial Voiceover\">commercial</a> or production project? If so, do please feel free to get in touch. You can listen to all of my different previous Santa voiceover jobs if that helps, but I'm also happy to provide a free sample from your script so that you can hear first hand whether my Santa voice is right for your project!<br>You can even listen in and direct the session too and hear Santa in action.</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"Guy Harris is the Official Voice of Santa","pageUrl":"the-official-voice-of-santa"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","906",{"href":"/voice-coaching-by-richard-di-britannia","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/voice-coaching-by-richard-di-britannia.jpg","alt":"voice-coaching-by-richard-di-britannia","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Richard Di Britannia - voice coach."}]]}],["$","$L3","473",{"href":"/apple-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/apple-voice-style.jpg","alt":"Apple Voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"That Apple Style VoiceOver?"}]]}],["$","$L3","679",{"href":"/batelco-wifi-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/batelco-wifi-voice.jpg","alt":"Batelco WiFi Voice","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Batelco WiFi Voice"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","