{
  "redirects": [
    { "source": "/FAQ", "destination": "/faq", "permanent": true },
    { "source": "/studiotour", "destination": "/voiceover-studio", "permanent": true },
    { "source": "/studiotour/", "destination": "/voiceover-studio", "permanent": true },
    { "source": "/gameshow-host.php", "destination": "/gameshow-host", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
