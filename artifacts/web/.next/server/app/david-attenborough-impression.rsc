0:["wrtXmcXlkJyGqbgwCa5zJ",[[["",{"children":[["slug","david-attenborough-impression","d"],{"children":["__PAGE__?{\"slug\":\"david-attenborough-impression\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","david-attenborough-impression","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/david-attenborough-impression#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"David Attenborough Impression\",\"item\":\"https://www.voiceoverguy.co.uk/david-attenborough-impression\"}]}"}}],["$","script","schema-2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/david-attenborough-impression#video\",\"name\":\"David Attenborough Impression\",\"thumbnailUrl\":\"https://img.youtube.com/vi/09ulDo-3reM/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/09ulDo-3reM\",\"author\":{\"@type\":\"Person\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk/voiceoverguy\",\"image\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-profile.jpg\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"VoiceoverGuy\",\"url\":\"https://www.voiceoverguy.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.png\"}},\"inLanguage\":\"en-GB\",\"description\":\"David Attenborough Impression - Biffa wanted to promote Wasteaters. They wanted a fun voice to accompany this beautiful shot video. I think we nailed it.\",\"uploadDate\":\"2016-09-01T00:00:00+00:00\"}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"David Attenborough Impression"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>Here is my David Attenborough Impression for Biffa. I really love this video. First, I had an awesome voice session with the client listening in and directing it. Second, the script was written really well. Third, it turned out amazing.</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main two-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>Who are the Wasteaters?</h2>\r\n<p>Towns and cities across the UK are currently being invaded by mysterious creatures known as the ‘Wasteaters'. These elusive beasts set off in the middle of the night to scour the streets for anything they can get their teeth into. <br>\r\nMilk cartons, magazines, anything you might have thrown away during your busy day is being eaten by the Wasteaters. <a href=\"/https://www.biffa.co.uk/\" target=\"_blank\" title=\"Biffa\">Biffa</a> specialises in domestic and business waste removal, which is a necessary, but not-so-glamorous service, so it's great to see them putting so much work into their commercials.</p> "}}],false,["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/09ulDo-3reM","title":"David Attenborough Impression","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}]}]]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/david-attenborough-impression.jpg","alt":"David Attenborough Impression","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<br>\r\n<h2>David Attenborough Impression</h2>\r\n<p>I've been practicing impressions for as long as I can remember. I used to mimic the teachers at school and I did a pretty spot-on impression of my doctor. But everyone interested in impressions will always gravitate to the biggest, most iconic voices, and it's hard to think of a voice more iconic that Sir David Attenborough's. If you'd like to hear more like this, check out my <a href=\"/david-attenborough-voice\" target=\"_blank\" title=\"David Attenborough Voiceover\">David Attenborough voiceover page</a>. I love voiceover, but I never thought I'd be get so many jobs because of my David Attenborough voice!. Even BBC's Strictly Come Dancing is now on my client list for this style too.</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Get in touch</h2>\r\n<p>I think we pulled this off fantastically. I'm really happy how it turned out. Do you have <a href=\"/commercial-voiceover\" target=\"_blank\" title=\"Commercial Voiceover\">commercial</a> that needs a <a href=\"/character-voiceover\" target=\"_blank\" title=\"Character Voiceover\">character voice</a>? One similar to this David Attenborough Impression? Please <a href=\"/contact-guy\" target=\"_blank\" title=\"Contact Guy\">get in touch</a>. To make the process even easier, just let me know the intended usage of the production and I can quote you more accurately. Send a short sample of the script and I'll send you a short audition. Check to see if my voice is right for your show or project. Please do get in touch today.</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"David Attenborough Impression","pageUrl":"david-attenborough-impression"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","770",{"href":"/opel-the-future-is-everyones","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/opel-the-future-is-everyones.jpg","alt":"opel-the-future-is-everyones","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Opel - The Future is Everyone's"}]]}],["$","$L3","933",{"href":"/lumote-mastermote-chronicles-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/lumote-mastermote-chronicles-voiceover.jpg","alt":"lumote-mastermote-chronicles-voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Lumote Mastermote Chronicles – Attenborough Voice"}]]}],["$","$L3","588",{"href":"/boov-pop-game-trailer","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/boov-pop-game-trailer.jpg","alt":"Boov Pop Game Trailer","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Boov Pop Game Trailer"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet"