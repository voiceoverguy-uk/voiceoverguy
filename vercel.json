    { "source": "/smoke-signal-voice/", "destination": "https://www.voiceoverguy.co.uk/", "statusCode": 301 },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "voiceoverguy.co.uk" }],
