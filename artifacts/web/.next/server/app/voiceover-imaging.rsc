0:["zmEFA7V4niAwXGr7KNBhH",[[["",{"children":["voiceover-imaging",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["voiceover-imaging",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"inner-page","children":[["$","section",null,{"className":"inner-hero","children":["$","div",null,{"className":"inner-container","dangerouslySetInnerHTML":{"__html":"<h1>Voiceover <span  class=\"ident\">imaging</span></h1>\r\n<p>I provide voiceover Imaging and sponsorship voices to the award winning UKRD Group and BBC Radio 1 & 2.<br>\r\nOther stations and brands around the globe that use my voice include GB News & Fun Kids.</p>"}}]}],["$","div",null,{"className":"inner-bar"}],["$","div",null,{"className":"inner-parallax","children":["$","div",null,{"className":"inner-container","children":[["$","div","0",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2><span class=\"ident\">Availability</span> is key</h2>\r\n<p>Radio stations choose imaging voices on their voices, flexibility and availability. Many have constantly changing promotions and client sponsorships, so being available is key to success<br>\r\nI work a lot with station sound at the BBC and provide imaging pieces for Radio 1 & 2.<br>\r\nCheck out the imaging and show intros for <a href=\"https://soundcloud.com/voiceoverguy/bbc-radio-1-big-weekend\"_blank\" title=\"The Big Weekend.\">The Big Weekend.</a></p>"}}],"$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/Z4oP6c1ebjI","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","1",{"className":"inner-row reverse","children":[["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/6zOVX7VeH2Y","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2><span class=\"ident\">Fun Kids</span> Radio</h2>\r\n<p>Adjusting to different times zones is essential too. All of which is not a problem when working with a full time voiceover.<br>\r\nI'm the station imaging voice for Fun Kids, the UK's radio station for kids, families and parents. Listen on DAB Digital Radio nationwide, online and mobile.\r\n</p>"}}],"$undefined","$undefined","$undefined"]}]]}],["$","div","2",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2>Radio<span class=\"ident\"> Imaging</span></h2>\r\n<p>Radio imaging is the general term for the composite effect of multiple and varied on-air sound effects that identify, brand and market a particular radio station. These sound effects include: voiceover, music beds, sweepers, intros, promos, liners, stingers, bumpers, and jingles.<br>\r\nFor your Imaging Voice, <a href=\"contact-guy\" class=\"isred\" target=\"_blank\" title=\"Get in Touch\">get in touch.</a></p>"}}],"$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined","$undefined","$undefined",["$","img",null,{"src":"/assets/images/imaging-voice-og.jpg","alt":"Voiceover Imaging – Guy Harris","style":{"width":"100%","borderRadius":4,"marginTop":8}}]]}]]}]]}]}]]}],null],null],null]},[null,["$","$L2",null,{"parallelRouterKey":"children","segmentPath":["children","voiceover-imaging","children"],"error":"$undefined","errorStyles":"$undefin