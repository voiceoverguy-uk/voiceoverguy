0:["wubufDEdrGena-B67LEmg",[[["",{"children":["on-hold-voice",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["on-hold-voice",{"children":["__PAGE__",{},[["$L1",["$","main",null,{"className":"inner-page","children":[["$","section",null,{"className":"inner-hero","children":["$","div",null,{"className":"inner-container","dangerouslySetInnerHTML":{"__html":"<h1>Thanks for calling your <span class=\"ident\">new on-hold voice</span></h1>\r\n<p>Every week I become the on hold voice of dozens of new companies. A friendly and sincere voice for your brand?<br>\r\nYour IVR should have a credible voice and one with experience. Thats exactly what you will get.</p>"}}]}],["$","div",null,{"className":"inner-bar"}],["$","div",null,{"className":"inner-parallax","children":["$","div",null,{"className":"inner-container","children":[[["$","div","0",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2>Please <span class=\"ident\">hold</span> the line</span></h2>\r\n<p>On hold marketing can be a massive benefit to a company's telephone system. The importance of promoting your product or brand to your callers while on hold should not be underestimated. <br>\r\nOn average callers to a business spend 33 seconds waiting to be connected. So, imagine what you could say to your callers during the time they are on hold or being transferred.</p>"}}],"$undefined","$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/cT7U03yDroE","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","1",{"className":"inner-row reverse","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2>Your call is  <span class=\"ident\">important </span>to us</span></h2>\r\n<p>I work with the UK's biggest on hold companies daily and become the voice of dozens of new companies every week.<br>\r\nWith a clear and concise delivery, promote your marketing message to callers while on hold or being connected.<br>\r\nKeeping the scripts short will have more impact.\r\n</p>"}}],"$undefined","$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined",["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/TqkdBK8mBW8","title":"YouTube video","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}],"$undefined","$undefined"]}]]}],["$","div","2",{"className":"inner-row","children":[["$","div",null,{"className":"inner-col","children":[["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<br><h2>We'll be with you <span class=\"ident\">in a moment</span></h2>\r\n<p>Phone prompts are actually very affordable. Starting at just £5 per short prompt. (minimum order fee applies)<br>\r\nWhy not enhance your companies on hold messaging? Take the opportunity to highlight your latest promotion, let them know of events you will be hosting or attending or just wish your callers Merry Christmas and Happy New Year.<br>\r\nWhat ever you decide to promote, do it with a voice of experience. <br>\r\nCall or email your enquiry and ideas by <a href=\"/contact-guy\" class=\"isred\" target=\"_blank\" title=\"Click to get in touch\">Getting in touch</a></p>\r\n</p>"}}],"$undefined","$undefined","$undefined","$undefined"]}],["$","div",null,{"className":"inner-col","children":["$undefined","$undefined","$undefined",["$","div",null,{"className":"blog-post-img-card","children":[["$","img",null,{"src":"/assets/images/on-hold-voice-og.webp","alt":"On Hold Voice – Guy Harris","className":"blog-post-img"}],["$","p",null,{"className":"blog-post-img-caption","children":"On Hold Voice – Guy Harris"}]]}]]}]]}]],["$","$L2",null,{"pageTitle":"On Hold Voice – IVR & Phone Prompts","pageUrl":"https://www.voiceoverguy.co.uk/on-hold-voice","intro":"Looking for a professional on-hold voiceover? Send me a quick message and I'll get back to you."}]]}]}],[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ProfilePage\",\"@id\":\"https://www.voiceoverguy.co.uk/on-hold-voice#profilepage\",\"url\":\"https://www.voiceoverguy.co.uk/on-hold-voice\",\"mainEntity\":{\"@type\":\"Person\",\"@id\":\"https://www.voiceoverguy.co.uk/#guyharris\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk\",\"image\":\"https://www.voiceoverguy.co.uk/images/guy-harris-profile.jpg\",\"jobTitle\":\"British Male Voiceover Artist\",\"sameAs\":[\"https://www.linkedin.com/in/voiceoverguy/\",\"https://www.youtube.com/user/voiceoverguyharris\"],\"description\":\"Guy Harris is a professional British on-hold and IVR voiceover artist, trusted by major UK companies for phone system prompts.\"}}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/on-hold-voice#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"item\":{\"@id\":\"https://www.voiceoverguy.co.uk/\",\"name\":\"Home\"}},{\"@type\":\"ListItem\",\"position\":2,\"item\":{\"@id\":\"https://www.voiceoverguy.co.uk/on-hold-voice\",\"name\":\"On Hold Voice\"}}]}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/on-hold-voice#video\",\"name\":\"On Hold Voice – IVR & Phone Prompts\",\"description\":\"On hold voice and IVR phone prompt demo by British voiceover artist Guy Harris.\",\"thumbnailUrl\":\"https://img.youtube.com/vi/cT7U03yDroE/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/cT7U03yDroE\",\"url\":\"https://www.youtube.com/watch?v=cT7U03yDroE\",\"uploadDate\":\"2014-07-29T00:00:00+00:00\"}"}}],["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"@id\":\"https://www.voiceoverguy.co.uk/on-hold-voice#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can you provide on-hold voiceover recordings for businesses?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Guy Harris is a professional voiceover artist with extensive experience recording on-hold messages for clients such as Baxi, Bupa, NS&I and more.\"}},{\"@type\":\"Question\",\"name\":\"What’s included in your on-hold voiceover service?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Typically, clients receive professionally recorded messages with multiple tone options and delivered as WAV or MP3 files, ready to be uploaded to any phone system.\"}},{\"@type\":\"Question\",\"name\":\"Where is your voiceover studio based?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Guy Harris records from a broadcast-quality studio in Wakefield, West Yorkshire, serving clients across the UK and globally.\"}}]}"}}]]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"children","segmentPath":["children","on-hold-voice","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/d67bbeffc4afbc33.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en-GB","children":[["$","head",null,{"children":[["$","link",null,{"rel":"icon",