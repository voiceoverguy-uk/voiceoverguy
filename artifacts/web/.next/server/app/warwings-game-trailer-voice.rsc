0:["PTF5f6zbP51hXl6zOpnuH",[[["",{"children":[["slug","warwings-game-trailer-voice","d"],{"children":["__PAGE__?{\"slug\":\"warwings-game-trailer-voice\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","warwings-game-trailer-voice","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/warwings-game-trailer-voice#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Warwings Game Trailer Voice\",\"item\":\"https://www.voiceoverguy.co.uk/warwings-game-trailer-voice\"}]}"}}],["$","script","schema-2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/warwings-game-trailer-voice#video\",\"name\":\"Warwings Game Trailer Voice\",\"thumbnailUrl\":\"https://img.youtube.com/vi/OqQ3N633hb8/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/OqQ3N633hb8\",\"author\":{\"@type\":\"Person\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk/voiceoverguy\",\"image\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-profile.jpg\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"VoiceoverGuy\",\"url\":\"https://www.voiceoverguy.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.png\"}},\"inLanguage\":\"en-GB\",\"description\":\"Warwings Game Trailer Voice - Another awesome game by MiniClip. Take to the skies and join the battle in epic WWII dogfights! As seen on TV.\",\"uploadDate\":\"2017-07-01T00:00:00+00:00\"}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"Warwings Game Trailer Voice"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>The test campaign in the UK for this epic game by MiniClip.</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main two-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>As seen and heard on TV.</h2>\r\n<p>I provided voiceover for the commercial trailer for a great mobile game. Working once again with another great agency in London, they asked me to provide a pilot voice for a trailer for a game called WarWings. They asked for a nice bit of energy and the 1940s moustached pilot style.  This direction was all I needed and they were happy with the end result. I've done a lot of <a href=\"/commercial-voiceover\" target=\"_blank\" title=\"TV commercial voiceover\">TV commercials</a> now and I think I've gotten really good at working out exactly what clients want. Often, the video has been made and the last thing they need is the voiceover, so it helps to be able to get my bearings quickly and I usually get the finished audio back to them on the same day.</p>"}}],false,["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/OqQ3N633hb8","title":"Warwings Game Trailer Voice","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}]}]]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/war-wings-game-trailer-voice.jpg","alt":"warwings-game-trailer-voice","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>What is WarWings?</h2>\r\n<p>Mobile gamers are going to love WarWings and it was lots of fun to talk about in the trailer. Gear up and don your helmet; the BEST WWII Aerial combat game is here! Get into the cockpit of your fully customizable, historically accurate \"warbird\" and experience the most epic World War II aerial dogfights ever! Fly solo as a lone wolf or team up with ally squadrons to control the skies. Compete against millions of players worldwide. Destroy enemy squadrons and climb global PvP leaderboards. <a href=\"https://twitter.com/warwingsmobile\" target=\"_blank\" title=\"Download now\" rel=\"noopener noreferrer\">Download now</a>.</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Need a pilot voiceover for your trailer?</h2>\r\n<p>Are you looking for the perfect old-fashioned WWII voice? Or maybe even the old <a href=\"/pathe-news-voice\" target=\"_blank\" title=\"Pathe voice style\">Pathe style voice</a> that the BBC used for decades? Whatever your project, I can help add the finishing touches with a high-quality, pitch-perfect voiceover. If you need to look through more of my previous work, take a listen to my <a href=\"/movie-trailer-voice\" target=\"_blank\" title=\"movie trailer voiceover\">movie trailer</a> and <a href=\"/game-trailer-voice\" target=\"_blank\" title=\"game trailer voiceover\">game trailer</a> voiceovers. If it helps, I can send you a sample of your script first, to help you see if my voice is right for your brand. Please <a href=\"/contact-guy\" target=\"_blank\" title=\"Get in touch!\">get in touch</a> </a> and tell me a little more about your project!</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"Warwings Game Trailer Voice","pageUrl":"warwings-game-trailer-voice"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","660",{"href":"/euroseal-windows-tv-advert","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/euroseal-windows-tv-advert.jpg","alt":"EuroSeal Windows TV advert","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"EuroSeal Windows TV advert"}]]}],["$","$L3","873",{"href":"/turkish-airlines-football-commentator-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/turkish-airlines-football-commentator-voiceover.jpg","alt":"turkish-airlines-football-commentator-voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Football Commentator - Turkish Air"}]]}],["$","$L3","468",{"href":"/turtle-strike-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/turtle-strike-voiceover.jpg","alt":"Turtle Strike Voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Turtle Strike Voiceover"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"r