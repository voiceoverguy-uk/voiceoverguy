0:["E629L-picyU8U0_43u8z4",[[["",{"children":[["slug","air-malta-voiceover","d"],{"children":["__PAGE__?{\"slug\":\"air-malta-voiceover\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","air-malta-voiceover","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/air-malta-voiceover#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Air Malta Voiceover\",\"item\":\"https://www.voiceoverguy.co.uk/air-malta-voiceover\"}]}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container page-header-nav-wrap","children":[["$","div",null,{"className":"page-header-content","children":[["$","h1",null,{"children":"Air Malta Voiceover"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>Let's talk about Air Malta, whose motto is 'We Care More' – Offering More Choice and Flexibility to Customers</p>\r\n"}}]]}],["$","div",null,{"className":"page-header-arrows","children":[null,null]}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main one-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>Check out the video</h2>\r\n<p>I've provided Air Malta with a good, crisp, clean voiceover for this explainer video. I'm being asked for more and more <a href=\"/explainer-video-voice\" target=\"_blank\" title=\"Explainer Video Voiceover\">explainer video voiceovers</a>, perhaps even more than standard <a href=\"/commercial-voiceover\" target=\"_blank\" title=\"Commercial Voiceover\">commercial voiceover</a>. The biggest advantage to this kind of video is clarity: if you have a detailed or otherwise complicated idea that you'd like to get across to your potential customers, then an explainer video (with clear voiceover and clean animation/video) can get the message across better than any other medium. Just check out my <a href=\"/rise-project-explainer-video-voiceover\" target=\"_blank\" title=\"Rise Project\">Rise Project</a> explainer videos.</p>"}}],false,false]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/air-malta-voiceover.jpg","alt":"Air Malta Voiceover","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<br>\r\n<h2>A little more about Air Malta</h2>\r\n<p>Air Malta was Malta's main airline and they worked hard to develop a well-known brand that is trusted all around the World. The thing that set Air Malta apart from its contemporaries was its dedication to offering customers more choice. By introducing three Economy Class products and three Business Class products there was more choice for customers. Even in the lowest price product - Simply Fly - this still included one piece of hand luggage and a small snack, in contrast to what most other carriers offer.</p>\r\n"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Get in touch</h2>\r\n<p>If you require a clean voice, or perhaps a more dramatic <a href=\"/movie-trailer-voice\" target=\"_blank\" title=\"Movie Trailer Voiceover\">movie trailer voice</a> for a promo or animation on your own website similar to this, then please get in touch. To make the whole process easier, just let me know the intended usage of the project and I can quote you more accurately. Feel free to send a short sample of the script and I can send you a short audition to check if my voice is right for your brand.</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"Air Malta Voiceover","pageUrl":"air-malta-voiceover"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","519",{"href":"/minecraft-combat-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/minecraft-combat-voiceover.jpg","alt":"Minecraft Combat Voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Minecraft Combat Voiceover"}]]}],["$","$L3","749",{"href":"/horizon-zero-dawn-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/horizon-zero-dawn-voice.jpg","alt":"horizon-zero-dawn-voice","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Horizon Zero Dawn – Attenborough Style"}]]}],["$","$L3","934",{"href":"/renton-trainspotting-choose-life-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/renton-trainspotting-choose-life-voiceover.jpg","alt":"renton-trainspotting-choose-life-voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Renton Trainspotting Choose Life"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","s