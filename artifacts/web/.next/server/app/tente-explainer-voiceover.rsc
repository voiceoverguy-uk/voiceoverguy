0:["wrtXmcXlkJyGqbgwCa5zJ",[[["",{"children":[["slug","tente-explainer-voiceover","d"],{"children":["__PAGE__?{\"slug\":\"tente-explainer-voiceover\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","tente-explainer-voiceover","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/tente-explainer-voiceover#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Happy Voiceover Style for TENTE\",\"item\":\"https://www.voiceoverguy.co.uk/tente-explainer-voiceover\"}]}"}}],["$","script","schema-2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"VideoObject\",\"@id\":\"https://www.voiceoverguy.co.uk/tente-explainer-voiceover#video\",\"name\":\"Happy Voiceover Style for TENTE\",\"thumbnailUrl\":\"https://img.youtube.com/vi/t_DDfKFjoRk/maxresdefault.jpg\",\"embedUrl\":\"https://www.youtube.com/embed/t_DDfKFjoRk\",\"author\":{\"@type\":\"Person\",\"name\":\"Guy Harris\",\"url\":\"https://www.voiceoverguy.co.uk/voiceoverguy\",\"image\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-profile.jpg\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"VoiceoverGuy\",\"url\":\"https://www.voiceoverguy.co.uk\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.voiceoverguy.co.uk/assets/images/guy-harris-voiceover.png\"}},\"inLanguage\":\"en-GB\",\"description\":\"Guy Harris provided the bright, natural voiceover for TENTE's great new explainer video. This video explains exactly what makes TENTE at the top of its industry\",\"uploadDate\":\"2019-07-01T00:00:00+00:00\"}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"Happy Voiceover Style for TENTE"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>Another great explainer video under my belt</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main two-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>TENTE's explainer video</h2>\r\n<p>If you spend more than a few minutes on my website, perhaps you're checking out my work to see whether you'd like to work with me, then you'll notice that I do more <a href=\"/explainer-video-voice\" target=\"_blank\" title=\"Explainer Video Voiceover\">explainer videos</a> than any other style of video. This is because explainer videos are rising in popularity as brands with niche or complex products search for a better way to sell themselves. And that's exactly that TENTE has done with this well made explainer video. Not every prduct or service I help sell is flashy, but that doesn't meant that your explainer videos or commercials can't be flashy! If you'd like to hear a few more of my explainer video voiceovers, check out my <a href=\"/traxart-explainer-voiceover\" target=\"_blank\" title=\"Traxart\">Traxart</a> and <a href=\"/home-composting-explainer-voice\" target=\"_blank\" title=\"Home Composting\">Home Composting</a> videos.</p>"}}],false,["$","div",null,{"className":"blog-media-col","children":["$","div",null,{"className":"embed-wrap","children":["$","iframe",null,{"src":"https://www.youtube.com/embed/t_DDfKFjoRk","title":"Happy Voiceover Style for TENTE","allow":"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture","allowFullScreen":true}]}]}]]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/tente-explainer-voiceover.jpg","alt":"tente-explainer-voiceover","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>A little more about TENTE</h2>\r\n<p><a href=\"/https://www.tente.com/en-gb\" target=\"_blank\" title=\"TENTE\">TENTE</a> is a castors and wheels company that provides extremely high-quality products to a huge range of industries, including institutional, medical, and manufacturing industries. TENTE is all about offering more than just practical products; it's about combining high-quality movement solutions with the flexibility to suit different companies' needs, even branding their products to suit your brand guidelines. It was great to work with the people over at TENTE. I think they've made a really great explainer video and I'd be happy to work with them again in the future.</p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Get in touch</h2>\r\n<p>If you're working on an explainer video or a <a href=\"/commercial-voiceover\" target=\"_blank\" title=\"Commercial Voiceover\">TV ad</a> and you need a happy voiceover style like the one I provided for TENTE, then please use the form to contact me. I like working with new companies, on products and services I've never worked with before. It's the best part of my job, really. If you'd like a little help working out if my voice is right for your next project, I'll be happy to read a free sample of your script.</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"Happy Voiceover Style for TENTE","pageUrl":"tente-explainer-voiceover"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","796",{"href":"/questions-about-voiceover-agencies","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/questions-about-voiceover-agencies.jpg","alt":"Questions About Voiceover Agencies","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Voiceover Agencies - The Facts"}]]}],["$","$L3","949",{"href":"/13-dead-end-drive-voiceover","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/13-dead-end-drive-voiceover.jpg","alt":"13-dead-end-drive-voiceover","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"13 Dead End Drive Voiceover"}]]}],["$","$L3","607",{"href":"/robocide-game-trailer-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/robocide-game-trailer-voice.jpg","alt":"Robocide Game Trailer Voice","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Robocide Game Trailer Voice"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/913cecfa117908b5.css","precedence":"next","crossOrigin":"$undefined"}]],["$","html",null,{"lang":"en-GB","children":[["$","head",null