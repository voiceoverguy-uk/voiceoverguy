0:["wrtXmcXlkJyGqbgwCa5zJ",[[["",{"children":[["slug","rakbank-voiceover","d"],{"children":["__PAGE__?{\"slug\":\"rakbank-voiceover\"}",{}]}]},"$undefined","$undefined",true],["",{"children":[["slug","rakbank-voiceover","d"],{"children":["__PAGE__",{},[["$L1",[[["$","script","schema-0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","script","schema-1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.voiceoverguy.co.uk/rakbank-voiceover#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.voiceoverguy.co.uk\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"News & Blog\",\"item\":\"https://www.voiceoverguy.co.uk/voiceover-news\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Rakbank Voiceover\",\"item\":\"https://www.voiceoverguy.co.uk/rakbank-voiceover\"}]}"}}]],["$","div",null,{"className":"page-header","children":["$","div",null,{"className":"container","children":[["$","h1",null,{"children":"Rakbank Voiceover"}],["$","div",null,{"className":"page-header-sub","dangerouslySetInnerHTML":{"__html":"<p>This Rakbank voiceover was used on this promotion for Home in One. On a daily basis I'm asked to put my voice on many <a href=\"/explainer-video-voice\">Explainer videos</a>. I understand this genre very well and am very comfortable working with big name brands. If your looking for a natural delivery on your next project, do check out some of my <a href=\"/crowd-hub-x-explainer-video-voiceover\">other work</a> with big brands.</p>"}}]]}]}],["$","section",null,{"className":"blog-post-body","children":["$","div",null,{"className":"container","children":[["$","div",null,{"className":"blog-post-main one-col","children":[["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>Check out the video</h2>\r\n<p>Explainers are big business and a website almost feels incomplete unless there is a short video highlighting the reasons for using them. Explainer videos are especially useful when you have a product or service that is a little too complex to explain with a normal ad. If your product or service is better than your competitors, then an explainer video can help you explain why this is. If you're convinced that an explainer video will help your business, you'll need a production company. Once you've found a great production company, let them know about my work. Or, if you need a few pointers, I'm more than happy to recommend one of the many awesome creative teams I work with every week.</p>"}}],false,false]}],["$","div",null,{"className":"blog-post-section two-col","children":[["$","div",null,{"className":"blog-media-col","children":["$","img",null,{"src":"/assets/img/blog/rakbank-voiceover.jpg","alt":"Rakbank Voiceover","className":"blog-post-img"}]}],["$","div",null,{"className":"blog-text-col","dangerouslySetInnerHTML":{"__html":"<h2>Here is more information about Home in One.<h2>\r\n<p><em>Rakbank Home in One is a mortgage loan that pays you interest. Home in One links your current account balances to your mortgage facility, in order to reduce the mortgage balance you’re charged interest on. This will help reduce your mortgage payments each month and can make a huge difference to your overall outgoings over a longer period of time.</em></p>"}}]]}],[],["$","div",null,{"className":"blog-bottom-text","dangerouslySetInnerHTML":{"__html":"<h2>Get in touch</h2>\r\n<p>Do you have an explainer video or <a href=\"/commercial-voiceover\" target=\"_blank\" title=\"Commercial Voiceover\">TV/Radio ad</a> in need of a voice? Maybe one like this Rakbank Voiceover? If so, please feel free to get in touch. To make the process even easier, just let me know the intended length and usage, and I can quote you more accurately. Send a short sample of the script and I'll send you a short audition. Check to see if my voice is right for your project. Please do get in touch today.</p>"}}],["$","div",null,{"className":"blog-post-cta","children":["$","$L3",null,{"href":"/voiceover-news","className":"cta-btn cta-btn--outline","children":"← Back to News & Blog"}]}],["$","$L4",null,{"pageTitle":"Rakbank Voiceover","pageUrl":"rakbank-voiceover"}]]}]}],["$","section",null,{"className":"blog-related-strip","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"blog-related-grid","children":[["$","$L3","991",{"href":"/p-and-o-ferries-christmas-santa-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/santa-po-ferries-christmas-ad.webp","alt":"Voice of Santa for P&O Ferries Christmas 2025 Campaign","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Voice of Santa for P&O Ferries Christmas Campaign"}]]}],["$","$L3","680",{"href":"/voiceover-studio-finder","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/voiceoverstudio-finder.jpg","alt":"Voiceover Studio Finder","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Voiceover Studio Finder "}]]}],["$","$L3","894",{"href":"/poundland-yoda-voice","className":"blog-related-card","children":[["$","div",null,{"className":"blog-related-img-wrap","children":["$","img",null,{"src":"/assets/img/blog/poundland-yoda-voice.jpg","alt":"poundland-yoda-voice","className":"blog-related-img"}]}],["$","div",null,{"className":"blog-related-title","children":"Yoda Voiceover for Poundland"}]]}]]}]}]}]],null],null],null]},[null,["$","$L5",null,{"parallelRouterKey":"children","segmentPath":["children","$6","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L7",null,{}],"templateStyles":"$undefin